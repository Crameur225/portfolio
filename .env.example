# Adresse publique du site (metadonnees, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://votre-domaine.com

# --- Acheminement des demandes de devis -------------------------------------
# Sans ces deux variables, les demandes sont ecrites dans ./demandes/devis.log
# au lieu d'etre envoyees par e-mail. Rien n'est jamais perdu.

# Cle API Resend (https://resend.com) :
RESEND_API_KEY=

# Expediteur verifie chez Resend, au format "Nom <adresse@domaine.com>" :
DEVIS_EXPEDITEUR=

# Destinataire des demandes (par defaut : gaelagbe@gmail.com) :
DEVIS_DESTINATAIRE=gaelagbe@gmail.com
